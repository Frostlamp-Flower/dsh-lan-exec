{
  "name": "dsh-lan-exec",
  "version": "1.0.0",
  "private": true,
  "description": "LAN remote execution for DeepSeek Harness: run model-authored tool calls on a paired host and share a replicated data space",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "setup.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.6",
    "dsh": "0.2.1-rc.5"
  },
  "license": "MIT"
}
